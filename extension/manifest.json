{
  "manifest_version": 3,
  "name": "Meme Intelligence Engine",
  "version": "1.0.0",
  "description": "Lightweight intelligence overlay for meme token analysis. Queries the MIE backend for similarity, developer history, meta, and lifecycle data.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MIE — Meme Intelligence Engine",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
