# =====================================================================
# MIE — Phase 2A environment variables
# Copy to `.env` and fill in your own values. NEVER commit real keys.
# =====================================================================

# ---- Provider selection -------------------------------------------------
#  mock   -> deterministic built-in mock provider (no network, no API keys)
#  solana -> real Solana RPC provider (reads SOLANA_* below)
DATA_PROVIDER=mock

# ---- Supabase / PostgreSQL ----------------------------------------------
# URL of the Postgres/Supabase API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key (read + the intentional open RLS on this research DB).
# For a stricter service-role pipeline, provide SUPABASE_SERVICE_ROLE_KEY
# and it will be used instead of the anon key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# ---- Solana provider (only used when DATA_PROVIDER=solana) ---------------
# Public RPC endpoint (no key required for light querying).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional premium RPC / DAS API key (never commit).
SOLANA_API_KEY=
# Conservative request budget; the provider backs off on HTTP 429.
SOLANA_RATE_LIMIT_RPS=5
# Cap on how many signatures are resolved to full transactions per ingest.
SOLANA_MAX_TX_PER_INGEST=50

# ---- Ingestion worker ----------------------------------------------------
INGEST_MAX_RETRIES=3
INGEST_BACKOFF_BASE_MS=250
INGEST_BACKOFF_MAX_MS=8000
INGEST_TAKE_SNAPSHOT=true        # store an initial market snapshot when market data exists
INGEST_DRY_RUN=false             # true = resolve + normalize only, never write to DB

# ---- Historical backfill worker ------------------------------------------
BACKFILL_BATCH_SIZE=10
BACKFILL_MAX_PAGES=5
BACKFILL_CHECKPOINT_ID=default
BACKFILL_RATE_LIMIT_RPS=5